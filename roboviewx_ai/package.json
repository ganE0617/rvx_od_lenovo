{
    "name": "ai-surveillance-service",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "dev:server": "node ./node_modules/ts-node/dist/bin.js apps/media-server/src/index.ts",
        "dev:viewer": "npm run dev -w web-roboviewx",
        "build": "turbo run build",
        "test": "turbo run test",
        "lint": "turbo run lint"
    },
    "devDependencies": {
        "turbo": "^2.0.0",
        "ts-node": "^10.9.1"
    },
    "packageManager": "pnpm@9.0.0"
}