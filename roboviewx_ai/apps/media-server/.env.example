PORT=3001

# Same-host dev: leave MEDIASOUP_ANNOUNCED_IP unset (server uses 127.0.0.1 for ICE).
# Remote: set to your public IP so viewers outside the LAN can connect.
# MEDIASOUP_ANNOUNCED_IP=

# MEDIASOUP_LISTEN_IP=0.0.0.0
# MEDIASOUP_MIN_PORT=40000
# MEDIASOUP_MAX_PORT=49999
PI_TILT_BASE_URL=http://172.30.1.39:8080
# Local dev: set to 1 to skip PTZ fetch (avoids timeout noise)
# DISABLE_PTZ=1
