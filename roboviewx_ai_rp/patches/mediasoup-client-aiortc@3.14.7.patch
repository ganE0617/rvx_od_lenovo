+def _ai_send_loop(handlers_ref) -> None:
+    """
+    Periodically sends latest detection_v1 JSON over any open DataChannel with label 'ai'.
+    This avoids routing detections through Node, minimizing latency and overhead.
+    """
+
+    # ── Diagnostics: print env flags once at thread start ──
+    # Use Logger.warning so messages appear even at default logLevel=warn
+    Logger.warning(
+        "ai: _ai_send_loop thread started | env: "
+        + str({
+            "AI_ENABLE": os.environ.get("AI_ENABLE", ""),
+            "AI_FORCE_BOX": os.environ.get("AI_FORCE_BOX", ""),
+            "AI_MODEL_PATH": os.environ.get("AI_MODEL_PATH", ""),
+            "AI_SEND_HZ": os.environ.get("AI_SEND_HZ", "12"),
+            "AI_FPS": os.environ.get("AI_FPS", "10"),
+            "AI_CONF": os.environ.get("AI_CONF", "0.2"),
+            "AI_IOU": os.environ.get("AI_IOU", "0.45"),
+            "AI_INPUT_W": os.environ.get("AI_INPUT_W", "640"),
+            "AI_INPUT_H": os.environ.get("AI_INPUT_H", "360"),
+            "AI_CLASSES": os.environ.get("AI_CLASSES", ""),
+            "python": sys.executable,
+        })
+    )
+
+    if edge_yolo_detector is None:
+        Logger.warning("ai: edge_yolo_detector import failed; AI disabled. sys.path=" + str(sys.path[:5]))
+        return
+
+    # Debug mode: when Node is sending a moving bbox (AI_FORCE_BOX=1),
+    # do not also send YOLO-based detection_v1 here (prevents duplicate streams).
+    if str(os.environ.get("AI_FORCE_BOX", "")).lower() in ("1", "true", "yes", "on"):
+        Logger.warning("ai: AI_FORCE_BOX=1 set; skipping YOLO detection_v1 sender loop (Node sends debug boxes)")
+        return
+
+    send_hz = max(1e-6, float(os.environ.get("AI_SEND_HZ", "12")))
+    send_interval = 1.0 / send_hz
+    last_status_log = 0.0
+    last_tx_log = 0.0
+    tx_total = 0
+    loop_iter = 0
+    last_loop_alive_log = 0.0
+
+    Logger.warning(f"ai: YOLO sender loop started (sendHz={send_hz:.1f}, interval={send_interval:.3f}s)")
+
+    while not _ai_stop.is_set():
+        try:
+            loop_iter += 1
+            now = time.time()
+
+            # ── Periodic "alive" log (1/sec) ──
+            has_frame = False
+            try:
+                latest, err, infer_ms, model_loaded = edge_yolo_detector.DETECTOR.get_latest()
+                dets = latest.get("detections") or []
+                has_frame = bool(latest.get("frame_id", 0))
+            except Exception as e:
+                latest = {}
+                err = str(e)
+                infer_ms = 0
+                model_loaded = False
+                dets = []
+
+            if (now - last_loop_alive_log) >= 1.0:
+                last_loop_alive_log = now
+                # Count open 'ai' DataChannels with detailed diagnostics
+                dc_count = 0
+                handler_count = len(handlers_ref)
+                dc_detail = ""
+                for hid, h in list(handlers_ref.items()):
+                    try:
+                        dcs_dict = getattr(h, "_dataChannels", {})
+                        dc_labels = []
+                        for dcid, dc in list(dcs_dict.items()):
+                            lbl = getattr(dc, "label", "?")
+                            rs = getattr(dc, "readyState", "?")
+                            dc_labels.append(f"{lbl}:{rs}")
+                            if lbl == "ai" and rs == "open":
+                                dc_count += 1
+                        if dc_labels:
+                            dc_detail += f" h[{hid[:8]}]={dc_labels}"
+                    except Exception as _e:
+                        dc_detail += f" h[{hid[:8]}]=err:{_e}"
+                Logger.warning(
+                    f"ai: YOLO loop alive iter={loop_iter} dets={len(dets)} "
+                    f"hasFrame={has_frame} modelLoaded={model_loaded} "
+                    f"handlers={handler_count} openDCs={dc_count}{dc_detail} err={err or 'none'}"
+                )
+
+            robot_id = os.environ.get("EDGE_ROOM_ID", "robot-001")
+            fw = int(latest.get("frame_w") or int(os.environ.get("AI_INPUT_W", "640") or 640))
+            fh = int(latest.get("frame_h") or int(os.environ.get("AI_INPUT_H", "360") or 360))
+            frame_id = int(latest.get("frame_id") or 0)
+            ts_ms = int(latest.get("ts_ms") or int(time.time() * 1000))
+
+            out_obj = {
+                "type": "detection_v1",
+                "robotId": robot_id,
+                "ts_ms": ts_ms,
+                "frame": {"w": fw, "h": fh, "id": frame_id},
+                "detections": dets,
+            }
+
+            out_payload = json.dumps(out_obj, separators=(",", ":"), ensure_ascii=False)
+
+            # Send detection via stderr to Node.js (because aiortc DataChannel
+            # never reaches 'open' state — mediasoup handles SCTP on the server).
+            # Node.js intercepts __AI_DET__: prefix and forwards via dataProducer.send().
+            try:
+                sys.stderr.write("__AI_DET__:" + out_payload + "\n")
+                sys.stderr.flush()
+                tx_total += 1
+            except Exception:
+                pass
+
+            if (now - last_status_log) > 5.0:
+                last_status_log = now
+                if not model_loaded:
+                    Logger.warning("ai: yolo model not loaded yet")
+                if err:
+                    Logger.warning(f"ai: yolo status err={err}")
+
+            if (now - last_tx_log) > 1.0:
+                last_tx_log = now
+                dets_len = len(out_obj.get("detections") or [])
+                Logger.warning(
+                    f"ai: TX detection_v1 via stderr dets={dets_len} conf={os.environ.get('AI_CONF', '0.2')} "
+                    f"inferMs={int(infer_ms or 0)} txTotal={tx_total}"
+                )
+
+        except Exception:
+            # NEVER let an exception kill the sender thread. Log and continue.
+            now = time.time()
+            if (now - last_status_log) > 2.0:
+                last_status_log = now
+                Logger.warning("ai: _ai_send_loop exception (continuing):\n" + traceback.format_exc())
+
+        time.sleep(send_interval)
+
