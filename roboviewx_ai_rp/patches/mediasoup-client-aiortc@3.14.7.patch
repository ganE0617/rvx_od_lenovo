+# === Snapshot feed (latest JPEG) ============================================
+#
+# Purpose: provide GET /snapshot.jpg without opening /dev/video0 twice.
+# This runs inside the SAME Python worker process that owns the camera (MediaPlayer v4l2).
+#
+# - Tap outgoing video track frames (recv)
+# - Background encoder at fixed FPS stores latest JPEG bytes
+# - HTTP handler returns latest bytes (last-frame only; no queues)
+#
+# Env:
+#   AIORTC_SNAPSHOT_PORT (default 8082; set to 0 to disable)
+#   AIORTC_SNAPSHOT_FPS  (default 5)
+#   AIORTC_SNAPSHOT_W / AIORTC_SNAPSHOT_H (optional; if set, encode at that size)
+#   AIORTC_SNAPSHOT_QUALITY (default 80)
+
+_snapshot_port = int(os.environ.get("AIORTC_SNAPSHOT_PORT", "8082"))
+_snapshot_fps = float(os.environ.get("AIORTC_SNAPSHOT_FPS", "5"))
+_snapshot_w = int(os.environ.get("AIORTC_SNAPSHOT_W", "0"))
+_snapshot_h = int(os.environ.get("AIORTC_SNAPSHOT_H", "0"))
+_snapshot_quality = int(os.environ.get("AIORTC_SNAPSHOT_QUALITY", "80"))
+
+_snap_lock = threading.Lock()
+_snap_stop = threading.Event()
+
+_ai_stop = threading.Event()
+
+
+def _snapshot_encoder_loop() -> None:
+    # Kept only as a low-overhead "alive" logger.
+    # Heavy encoding happens inside edge_snapshot_store's background thread.
+    interval = 1.0 / max(1e-6, _snapshot_fps)
+    last_log = 0.0
+    while not _snap_stop.is_set():
+        time.sleep(interval)
+        now = time.time()
+        if now - last_log > 10.0:
+            last_log = now
+            if edge_snapshot_store is None:
+                continue
+            st = edge_snapshot_store.STORE.status(getpid()).to_dict()
+            Logger.debug(
+                f"snapshot: alive frames={st.get('framesInTotal')} jpegBytes={st.get('jpegBytes')} encOk={st.get('encodeOkTotal')} encFail={st.get('encodeFailTotal')}"
+            )
+
