+class _SnapshotHandler(BaseHTTPRequestHandler):
+    def do_HEAD(self):  # noqa: N802
+        u = urlparse(self.path)
+        if u.path != "/snapshot.jpg":
+            self.send_response(404)
+            self.end_headers()
+            return
+
+        if edge_snapshot_store is None:
+            jpeg = None
+            meta = {"w": 0, "h": 0, "ts_ms": 0}
+        else:
+            jpeg = edge_snapshot_store.STORE.get_cached_jpeg()
+            meta = edge_snapshot_store.STORE.jpeg_meta()
+
+        if jpeg is None:
+            self.send_response(503)
+            self.send_header("Content-Length", "0")
+            self.send_header("Cache-Control", "no-store, max-age=0")
+            self.end_headers()
+            return
+
+        self.send_response(200)
+        self.send_header("Content-Type", "image/jpeg")
+        self.send_header("Content-Length", str(len(jpeg)))
+        self.send_header("Cache-Control", "no-store, max-age=0")
+        self.send_header("X-Frame-W", str(meta.get("w", 0)))
+        self.send_header("X-Frame-H", str(meta.get("h", 0)))
+        self.send_header("X-Frame-TsMs", str(meta.get("ts_ms", 0) or 0))
+        self.end_headers()
+
+    def do_GET(self):  # noqa: N802
+        u = urlparse(self.path)
+        if u.path == "/snapshot/ping":
+            body = b"ok"
+            self.send_response(200)
+            self.send_header("Content-Type", "text/plain")
+            self.send_header("Content-Length", str(len(body)))
+            self.send_header("Cache-Control", "no-store, max-age=0")
+            self.end_headers()
+            try:
+                self.wfile.write(body)
+            except Exception:
+                pass
+            return
+
+        if u.path == "/snapshot/status":
+            if edge_snapshot_store is None:
+                payload = {
+                    "ok": False,
+                    "pid": getpid(),
+                    "hasFrame": False,
+                    "lastFrameTsMs": None,
+                    "lastJpegTsMs": None,
+                    "jpegBytes": 0,
+                    "framesInTotal": 0,
+                    "encodeOkTotal": 0,
+                    "encodeFailTotal": 0,
+                    "lastEncodeError": "edge_snapshot_store import failed (PYTHONPATH not set?)",
+                    "source": "",
+                    "port": _snapshot_port,
+                    "encoderFps": _snapshot_fps,
+                    "lastRawShape": None,
+                    "lastRawType": None,
+                }
+            else:
+                payload = edge_snapshot_store.STORE.status(getpid()).to_dict()
+            body = json.dumps(payload, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body)))
+            self.send_header("Cache-Control", "no-store, max-age=0")
+            self.end_headers()
+            try:
+                self.wfile.write(body)
+            except Exception:
+                pass
+            return
+
+        if u.path != "/snapshot.jpg":
+            self.send_response(404)
+            self.end_headers()
+            return
+
+        # Optional query w/h: request resize for next background encode.
+        # Handler remains fast: it returns cached bytes only (no heavy encode here).
+        qs = parse_qs(u.query)
+        qw = int(qs.get("w", ["0"])[0] or "0")
+        qh = int(qs.get("h", ["0"])[0] or "0")
+        qw = int(qw) if qw else 0
+        qh = int(qh) if qh else 0
+
+        # Cap to avoid accidental huge encodes
+        if qw and (qw < 16 or qw > 4096):
+            qw = 0
+        if qh and (qh < 16 or qh > 4096):
+            qh = 0
+
+        if qw and not qh:
+            qh = qw
+        if qh and not qw:
+            qw = qh
+
+        if edge_snapshot_store is None:
+            jpeg = None
+            meta = {"w": 0, "h": 0, "ts_ms": 0}
+        else:
+            if qw or qh:
+                edge_snapshot_store.STORE.request_size(qw, qh)
+            jpeg = edge_snapshot_store.STORE.get_cached_jpeg()
+            meta = edge_snapshot_store.STORE.jpeg_meta()
+
+        # If request wants a specific size, only return if cache matches.
+        if (qw and int(meta.get("w") or 0) != qw) or (qh and int(meta.get("h") or 0) != qh):
+            jpeg = None
+
+        if not jpeg:
+            self.send_response(503)
+            self.send_header("Content-Length", "0")
+            self.send_header("Cache-Control", "no-store, max-age=0")
+            self.end_headers()
+            return
+        self.send_response(200)
+        self.send_header("Content-Type", "image/jpeg")
+        self.send_header("Content-Length", str(len(jpeg)))
+        self.send_header("Cache-Control", "no-store, max-age=0")
+        self.send_header("X-Frame-W", str(meta.get("w", 0)))
+        self.send_header("X-Frame-H", str(meta.get("h", 0)))
+        self.send_header("X-Frame-TsMs", str(meta.get("ts_ms", 0) or 0))
+        self.end_headers()
+        try:
+            self.wfile.write(jpeg)
+        except Exception:
+            return
+
+    def log_message(self, format, *args):  # noqa: A002
+        # silence default http.server logging
+        return
+
