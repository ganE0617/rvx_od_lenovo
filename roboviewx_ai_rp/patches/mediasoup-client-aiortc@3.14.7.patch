+def _start_snapshot_server() -> None:
+    if _snapshot_port <= 0:
+        return
+    try:
+        httpd = ThreadingHTTPServer(("0.0.0.0", _snapshot_port), _SnapshotHandler)
+    except Exception as e:
+        Logger.error(f"snapshot: failed to bind port {_snapshot_port}: {e}")
+        return
+
+    t_enc = threading.Thread(target=_snapshot_encoder_loop, daemon=True)
+    t_enc.start()
+
+    def _serve():
+        Logger.debug(f"snapshot: http server listening on 0.0.0.0:{_snapshot_port} (GET /snapshot.jpg, /snapshot/status, /snapshot/ping)")
+        try:
+            httpd.serve_forever(poll_interval=0.5)
+        except Exception:
+            pass
+
+    t_http = threading.Thread(target=_serve, daemon=True)
+    t_http.start()
+
+    # Store shutdown closure on globals
+    def _shutdown():
+        try:
+            httpd.shutdown()
+        except Exception:
+            pass
+        try:
+            httpd.server_close()
+        except Exception:
+            pass
+
+    global _snapshot_shutdown
+    _snapshot_shutdown = _shutdown
+
