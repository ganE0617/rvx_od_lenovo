# Environment Configuration for Edge Agent

# Room & Peer Identity
EDGE_ROOM_ID=robot-001
EDGE_PEER_ID=edge-pi-001

# Signaling Server (IMPORTANT: use http:// for Socket.IO, not ws://)
# Same-host dev: default is http://127.0.0.1:3001 (unset = local media-server).
# Remote: set to media-server host, e.g. http://192.168.1.100:3001
# SIGNALING_URL=http://127.0.0.1:3001

# Socket.IO Event Names (optional, defaults shown)
# SIGNALING_RPC_REQUEST_EVENT=rpc:request
# SIGNALING_RPC_RESPONSE_EVENT=rpc:response
# SIGNALING_RPC_EVENT_EVENT=rpc:event

# Video Source
# Options: test (color bars), file (mp4 playback), webcam (future)
VIDEO_SOURCE=test
# VIDEO_FILE=/path/to/video.mp4
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FRAMERATE=30

# Codec (VP8 recommended for best compatibility)
CODEC=VP8

# TURN/STUN Configuration (optional, for NAT traversal)
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=username
# TURN_CREDENTIAL=password

# Reconnection Settings
RECONNECT_ENABLED=true
RECONNECT_MAX_RETRIES=10
RECONNECT_BASE_DELAY_MS=1000
RECONNECT_MAX_DELAY_MS=30000

# Tilt REST API
TILT_PORT=8080

# Logging
# Options: trace, debug, info, warn, error
LOG_LEVEL=info
