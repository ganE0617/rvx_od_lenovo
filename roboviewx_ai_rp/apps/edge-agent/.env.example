# Environment Configuration for Edge Agent

# Room & Peer Identity
EDGE_ROOM_ID=robot-001

# P2P Signaling Server (edge-agent hosts this WebSocket server)
SIGNALING_HOST=0.0.0.0
SIGNALING_PORT=8082

# ICE (STUN/TURN) config sent to browser + used by python worker
# Example STUN:
ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]
# Example TURN:
# ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"],"username":"USER","credential":"PASS"}]

# Video Source
# Options: test (color bars), file (mp4 playback), webcam (future)
VIDEO_SOURCE=test
# VIDEO_FILE=/path/to/video.mp4
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FRAMERATE=30

# Camera capture for python worker (recommended)
EDGE_VIDEO_SOURCE=v4l2:/dev/video0?size=1280x720&fps=30&format=mjpeg

# P2P video codec preference (vp8 or h264)
P2P_VIDEO_CODEC=vp8

# Edge YOLO (optional)
AI_ENABLE=1
AI_MODEL_PATH=/abs/path/to/yolo11n.pt
AI_FPS=10
AI_SEND_HZ=12
AI_CONF=0.25
AI_IOU=0.45
AI_INPUT_W=640
AI_INPUT_H=360
# AI_CLASSES=0

# Reconnection Settings
RECONNECT_ENABLED=true
RECONNECT_MAX_RETRIES=10
RECONNECT_BASE_DELAY_MS=1000
RECONNECT_MAX_DELAY_MS=30000

# Tilt REST API
TILT_PORT=8080

# Logging
# Options: trace, debug, info, warn, error
LOG_LEVEL=info
